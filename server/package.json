{
  "name": "arogyax-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync service between the WHV handset queue and MongoDB. See contracts/sync.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "export:snowflake": "node --env-file=.env scripts/export_to_snowflake.js",
    "seed:demo": "node --env-file=.env scripts/seed_synthetic.js",
    "seed:demo:clear": "node --env-file=.env scripts/seed_synthetic.js --clear",
    "verify:tracks": "node --env-file=.env scripts/verify_tracks.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.21.1",
    "mongodb": "^6.9.0",
    "snowflake-sdk": "^3.2.0"
  }
}
